generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScheduleStatus {
  QUEUED
  COMPLETED
  PARTIAL_FAILURE
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
  NEEDS_REVIEW
}

model Tenant {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  slug             String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  memberships      Membership[]
  schedules        Schedule[]
  emails           ScheduledEmail[]
  outbox           OutboxEvent[]
  slackConnection  SlackConnection?
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  googleSub   String?      @unique
  passwordHash String?
  email       String       @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  schedules   Schedule[]
}

model Membership {
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
}

model Schedule {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  createdById  String           @db.Uuid
  name         String
  sourceName   String?
  subject      String
  bodyText     String
  bodyHtml     String?
  defaultFrom  String
  delayMs      Int              @default(1000)
  hourlyLimit  Int              @default(100)
  idempotencyKey String?
  status       ScheduleStatus   @default(QUEUED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  emails       ScheduledEmail[]

  @@index([tenantId, createdAt])
  @@unique([tenantId, idempotencyKey])
}

model ScheduledEmail {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  scheduleId   String      @db.Uuid
  toAddress    String
  fromAddress  String
  subject      String
  bodyText     String
  bodyHtml     String?
  scheduledAt  DateTime
  status       EmailStatus @default(PENDING)
  attempts     Int         @default(0)
  jobId        String      @unique
  nextAttemptAt DateTime?
  lastError    String?
  messageId    String?
  previewUrl   String?
  sentAt       DateTime?
  isStarred    Boolean    @default(false)
  archivedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule     Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attachments  EmailAttachment[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, archivedAt])
  @@index([tenantId, isStarred])
  @@index([scheduleId])
}

model EmailAttachment {
  id              String        @id @default(uuid()) @db.Uuid
  scheduledEmailId String       @db.Uuid
  filename        String
  contentType     String
  sizeBytes       Int
  content         Bytes         @db.ByteA
  createdAt       DateTime      @default(now())
  scheduledEmail  ScheduledEmail @relation(fields: [scheduledEmailId], references: [id], onDelete: Cascade)

  @@index([scheduledEmailId])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  kind        String
  aggregateId String    @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([kind, aggregateId])
  @@index([publishedAt, createdAt])
}

model SlackConnection {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @db.Uuid
  teamId          String   @unique
  teamName        String?
  slackUserId     String?
  accessToken     String
  webhookUrl      String?
  channelId       String?
  channelName     String?
  scope           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
