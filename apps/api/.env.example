# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Optional comma-separated additional frontend origins, such as Vercel
# deployment URLs that should use the same API.
WEB_ORIGINS=
SESSION_SECRET=local-development-session-secret-change-me
ALLOW_DEV_AUTH=false

# Local PostgreSQL / Redis / Elasticsearch defaults are safe development values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=reachinbox-emails

# Google OAuth. Leave blank until a real OAuth client is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Slack OAuth. Leave blank until a real Slack app is configured.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback
SLACK_RATE_LIMIT_CHANNEL=

# Ethereal SMTP. If both credentials are blank the worker creates a temporary
# Ethereal account at send time. Set real Ethereal values for a stable inbox.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASS=
# Optional JSON array for multiple Ethereal identities. Each item is
# {"from":"sender@example.test","user":"...","pass":"..."}.
ETHEREAL_SENDERS_JSON=
DEFAULT_FROM=ReachInbox <no-reply@example.test>

# Queue and scheduling controls
WORKER_CONCURRENCY=5
OUTBOX_POLL_MS=5000
SENDER_MIN_DELAY_MS=2000
SENDER_HOURLY_LIMIT=200
MAX_EMAIL_ATTEMPTS=3
MAX_UPLOAD_BYTES=5242880
MAX_ATTACHMENT_COUNT=5
MAX_ATTACHMENT_BYTES=2097152
MAX_TOTAL_ATTACHMENT_BYTES=10485760
